figures/
checkpoints/
results/

# ---------------------------------------------------------------------------
# Data — large and/or credentialed (eICU & FAERS/PhysioNet are access-controlled)
# rebuild processed graphs with scripts/run_prepare_data.sh
# ---------------------------------------------------------------------------
dataset/
db_export/

# ---------------------------------------------------------------------------
# Secrets / local config (copy configs/db.yaml.template -> configs/db.yaml)
# ---------------------------------------------------------------------------
configs/db.yaml

# ---------------------------------------------------------------------------
# Third-party paper PDFs — don't redistribute (cite them in the paper instead).
# Remove this line if you keep the repo private and want them included.
# ---------------------------------------------------------------------------
references/

